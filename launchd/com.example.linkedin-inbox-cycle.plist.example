<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.linkedin-inbox-cycle</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH=/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin; cd '__PROJECT_DIR__' &amp;&amp; npm run network:accept &amp;&amp; sleep 300 &amp;&amp; npm run dm:check</string>
  </array>
  <key>StartInterval</key>
  <integer>1620</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/inbox.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/inbox.err.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
