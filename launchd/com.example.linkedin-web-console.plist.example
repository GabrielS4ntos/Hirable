<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.linkedin-web-console</string>
  <!--
    Keeps the local web console and its scheduler alive. This single agent replaces
    the per-pipeline plists: schedules now live in SQLite and are edited in the
    Configuracoes screen at http://127.0.0.1:4321.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH=/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin; cd '__PROJECT_DIR__' &amp;&amp; npm run web</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/web.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/web.err.log</string>
</dict>
</plist>
