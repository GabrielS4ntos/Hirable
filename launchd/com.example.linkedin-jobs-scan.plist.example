<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.linkedin-jobs-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH=/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin; cd '__PROJECT_DIR__' &amp;&amp; npm run jobs:apply</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>11</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>13</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/jobs.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/jobs.err.log</string>
</dict>
</plist>
